    {
      "name": "07 Enroll Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{enrollmentBase}}/api/v1/students/{{studentId}}/enrollments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseId\": \"{{courseId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Enrolls student, but in the backend validates the active Course over HTTP"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Keep the first enrollment ID so re-enrollment can prove it created a new record",
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.environment.set(\"enrollmentId\", pm.response.json().id);",
              "pm.test(\"UUID and Location\", function () { pm.expect(pm.response.json().id).to.match(/^[a-f0-9-]{36}$/); pm.expect(pm.response.headers.get(\"Location\")).to.include(pm.environment.get(\"enrollmentId\")); });",
              "pm.environment.set(\"originalEnrollmentId\", pm.response.json().id);",
              "pm.test(\"UTC timestamp\", () => pm.expect(pm.response.json().enrolledAt).to.match(/Z$/));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Reject Duplicate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{enrollmentBase}}/api/v1/students/{{studentId}}/enrollments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseId\": \"{{courseId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "The same Student/Course pair produces a 409 conflict, not a second row"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A rejection is a passing test when its HTTP status and stable error code match",
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });",
              "pm.test(\"ProblemDetail\", function () { const p=pm.response.json(); pm.expect(p.status).to.eql(pm.response.code); pm.expect(p.instance).to.be.a(\"string\"); pm.expect(p.detail).to.be.a(\"string\"); });",
              "pm.test(\"Error code\", function () { pm.expect(pm.response.json().code).to.eql(\"ALREADY_ENROLLED\"); });"
            ]
          }
        }
      ]
    },
