              "pm.test(\"UUID and Location\", function () { pm.expect(pm.response.json().id).to.match(/^[a-f0-9-]{36}$/); pm.expect(pm.response.headers.get(\"Location\")).to.include(pm.environment.get(\"enrollmentId\")); });",
