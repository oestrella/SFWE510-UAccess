          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{enrollmentBase}}/api/v1/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentNumber\": \"PM{{runToken}}1\",\n  \"name\": \"Fictitious Student 1\",\n  \"email\": \"pm{{runToken}}1@example.invalid\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Create the Student who will enroll; the Enrollment service owns/stores this identity."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Save the server-generated Student ID for the nested enrollment route.",
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.environment.set(\"studentId\", pm.response.json().id);",
              "pm.test(\"UUID and Location\", function () { pm.expect(pm.response.json().id).to.match(/^[a-f0-9-]{36}$/); pm.expect(pm.response.headers.get(\"Location\")).to.include(pm.environment.get(\"studentId\")); });"
            ]
          }
        }
      ]
    },
