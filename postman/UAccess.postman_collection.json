            "value": "application/json"
          }
        ],
        "url": "{{courseBase}}/api/v1/courses/{{courseId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseCode\": \"PM{{runToken}}\",\n  \"title\": \"Updated Postman course\",\n  \"description\": \"Demo only\",\n  \"credits\": 3,\n  \"active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Updates the existing Course"
