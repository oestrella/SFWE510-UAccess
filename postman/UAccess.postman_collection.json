{
  "info": {
    "name": "UAccess Phase 1 - executable workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Create Course",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{courseBase}}/api/v1/courses",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseCode\": \"PM{{runToken}}\",\n  \"title\": \"Fictitious Postman course\",\n  \"description\": \"Demo only\",\n  \"credits\": 3,\n  \"active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Create an active catalog entry and save the generated UUID to environment variable for other requests"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A fresh token avoids identity conflicts when I rerun this collection.",
              "pm.environment.set(\"runToken\", Date.now().toString(36) + Math.random().toString(36).substring(2,6));",
              "pm.environment.set(\"missingCourseId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.environment.set(\"courseId\", pm.response.json().id);",
              "pm.test(\"UUID and Location\", function () { pm.expect(pm.response.json().id).to.match(/^[a-f0-9-]{36}$/); pm.expect(pm.response.headers.get(\"Location\")).to.include(pm.environment.get(\"courseId\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Read Course, HATEOAS",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{courseBase}}/api/v1/courses/{{courseId}}",
        "description": "Clients receive a self link path to this resource"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Course self link\", () => pm.expect(pm.response.json()._links.self.href).to.include(pm.environment.get(\"courseId\")));"
            ]
          }
        }
      ]
    },
